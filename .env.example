# Copy to .env.local (never commit real values). On Vercel set the same names under Project → Settings → Environment Variables.
DATABASE_URL=            # Neon pooled connection string (neon deploy / neon env pull fills it)
DATABASE_URL_UNPOOLED=   # Neon direct connection, used by npm run db:setup
SESSION_SECRET=          # at least 32 random characters: openssl rand -base64 48
ADMIN_PASSWORD=          # curator: approve, reject, delete
EDITOR_PASSWORD=         # editor: add and edit (changes wait for approval)
# Neon Object Storage, private "uploads" bucket (neon deploy fills these)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
